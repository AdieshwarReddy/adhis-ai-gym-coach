# Adhi's AI Gym Coach - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Supabase Cloud Configuration (PostgreSQL + Auth + Storage)
# Obtain from: Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Groq Cloud API Key (LLaMA 3.3 70B Versatile AI Coach)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (Gemini 2.5 Flash AI Coach)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# Google Maps Platform Configuration (Cardio GPS Routes)
# Maps JavaScript API Key (Optional - If omitted, OpenStreetMap is used automatically)
GOOGLE_MAPS_API_KEY=
MAP_PROVIDER=osm

# GPS Quality & Cardio Filtering Parameters
GPS_MAX_ACCURACY_METERS=50
GPS_MIN_DISTANCE_METERS=3
GPS_MIN_INTERVAL_SECONDS=2

# Application Environment & Feature Toggles
APP_ENV=development
LLM_ENABLED=true
VOICE_ENABLED=true
